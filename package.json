{
  "name": "pickit-web",
  "private": true,
  "version": "1.0.0",
  "description": "PicKit for iOS: an offline photo editor that installs to the iPhone Home Screen.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && tsc -p tsconfig.node.json && vite build && node scripts/audit-bundle.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets": "node scripts/generate-assets.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@preact/signals": "2.11.4",
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
